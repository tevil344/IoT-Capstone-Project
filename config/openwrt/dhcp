config dnsmasq
	option domainneeded '1'
	option boguspriv '1'
	option filterwin2k '0'
	option localise_queries '1'
	option rebind_protection '1'
	option rebind_localhost '1'
	option local '/lan/'
	option domain 'lan'
	option expandhosts '1'
	option nonegcache '0'
	option authoritative '1'
	option readethers '1'
	option leasefile '/tmp/dhcp.leases'
	option resolvfile '/tmp/resolv.conf.d/resolv.conf.auto'
	option nonwildcard '1'
	option localservice '1'

# Trusted LAN DHCP Configuration
config dhcp 'lan'
	option interface 'lan'
	option start '100'
	option limit '150'
	option leasetime '12h'
	option dhcpv4 'server'
	option dhcpv6 'server'
	option ra 'server'
	option ra_slaac '1'
	list ra_flags 'managed-config'
	list ra_flags 'other-config'

# Quarantine DHCP Configuration (Short 2m lease for rapid re-evaluation upon promotion)
config dhcp 'quarantine'
	option interface 'quarantine'
	option start '50'
	option limit '100'
	option leasetime '2m'
	option dhcpv4 'server'
	option dhcpv6 'disabled'
	option ra 'disabled'
	# Push gateway IP as DNS and NTP server only
	list dhcp_option '6,192.168.20.1'
	list dhcp_option '42,192.168.20.1'

