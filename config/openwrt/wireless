config wifi-device 'radio0'
	option type 'mac80211'
	option path 'platform/soc/fe300000.mmcnr/mmc_host/mmc1/mmc1:0001/mmc1:0001:1'
	option channel '36'
	option band '5g'
	option htmode 'VHT80'
	option disabled '0'

config wifi-device 'radio1'
	option type 'mac80211'
	option path 'platform/soc/fe300000.mmcnr/mmc_host/mmc1/mmc1:0001/mmc1:0001:2'
	option channel '1'
	option band '2g'
	option htmode 'HT20'
	option disabled '0'

# Quarantine Onboarding Network - Strict Client Isolation Enabled
config wifi-iface 'onboard'
	option device 'radio1'
	option mode 'ap'
	option ssid 'IoT-Onboarding'
	option encryption 'psk2'
	option key 'OnboardGuestKey2026'
	option network 'quarantine'
	option isolate '1'

# Trusted IoT Production Network - WPA2/WPA3 Mixed
config wifi-iface 'trusted_iot'
	option device 'radio1'
	option mode 'ap'
	option ssid 'IoT-Secure-Production'
	option encryption 'sae-mixed'
	option key 'ProductionSuperSecretKey99'
	option network 'lan'
	option isolate '0'

